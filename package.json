{
  "name": "cleveland-sun-study",
  "version": "2.0.0",
  "description": "Photo-informed daylight tour with baked navigation, native Blender detail and private GPU streaming",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node scripts/check_assets.mjs",
    "host": "node remote/server.mjs",
    "test:remote": "node tests/remote-host.mjs",
    "test:connection": "node tests/connection.mjs",
    "test:sharing": "node tests/sharing.mjs",
    "test:baked": "node scripts/check_baked.mjs",
    "test:navigation": "node tests/navigation.mjs",
    "format:check": "prettier --check app/main.js app/navigation.js app/baked-lighting.js app/load-scene.js remote/client.js remote/server.mjs",
    "test:cycles": "node tests/cycles-renderer.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "jose": "6.2.12",
    "puppeteer-core": "25.10.0",
    "qrcode": "1.5.4",
    "suncalc": "^1.9.0",
    "three": "^0.180.0",
    "three-gpu-pathtracer": "^0.0.23",
    "three-mesh-bvh": "^0.9.1",
    "vite": "^7.3.5",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "meshoptimizer": "1.2.0",
    "prettier": "^3.9.6"
  }
}
